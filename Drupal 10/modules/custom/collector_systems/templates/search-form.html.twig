{% set current_path = path('<current>') %}
{% set pagename = current_path | split('/') | last %}

<form class="search-form" onsubmit="return chksearchfordata('{{ pagename }}');">
  <input id="searchindata" type="search" class="expand-search" autocomplete="off" name="" value="{{ qSearch }}" placeholder="Search...">
  <span id="clearInputText" class="clear-search" role="button" aria-label="{{ 'Clear search'|t }}" title="{{ 'Clear search'|t }}" onmousedown="event.preventDefault();" onclick="return clearSearchData('{{ pagename }}');">&times;</span>
  {% if qSearch %}
    <span class="cs-search-active-dot" aria-hidden="true"></span>
  {% endif %}
</form>
